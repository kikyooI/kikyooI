/* app.wxss 全局样式 */
page {
  background-color: #F5F6FA;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Segoe UI, Arial, sans-serif;
  color: #333;
  font-size: 28rpx;
}

.container {
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-between {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.flex-1 {
  flex: 1;
}

.btn-primary {
  background: #4A90D9;
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  padding: 20rpx 0;
  text-align: center;
}

.btn-primary[disabled] {
  background: #a8c8e8;
}

.btn-danger {
  background: #e74c3c;
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  padding: 20rpx 0;
  text-align: center;
}

.btn-outline {
  border: 2rpx solid #4A90D9;
  color: #4A90D9;
  border-radius: 48rpx;
  font-size: 28rpx;
  padding: 12rpx 32rpx;
  text-align: center;
  background: #fff;
}

.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.tag-blue {
  background: #e8f2fc;
  color: #4A90D9;
}

.tag-green {
  background: #e8f8ee;
  color: #27ae60;
}

.tag-orange {
  background: #fdf2e6;
  color: #e67e22;
}

.tag-red {
  background: #fdeaea;
  color: #e74c3c;
}

.tag-gray {
  background: #f0f0f0;
  color: #999;
}

.text-muted {
  color: #999;
  font-size: 24rpx;
}

.text-primary {
  color: #4A90D9;
}

.divider {
  height: 1rpx;
  background: #eee;
  margin: 24rpx 0;
}

.empty {
  text-align: center;
  padding: 120rpx 0;
  color: #bbb;
  font-size: 28rpx;
}

.empty image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 24rpx;
}

/* 表单 */
.form-item {
  margin-bottom: 32rpx;
}

.form-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 12rpx;
  display: block;
}

.form-input {
  width: 100%;
  height: 80rpx;
  background: #f5f6fa;
  border-radius: 12rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

.form-textarea {
  width: 100%;
  min-height: 160rpx;
  background: #f5f6fa;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin: 32rpx 0 20rpx;
}

/* 底部固定操作栏 */
.footer-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
  z-index: 100;
}

/* 全局右下角悬浮按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #4A90D9;
  color: #fff;
  font-size: 56rpx;
  text-align: center;
  line-height: 100rpx;
  box-shadow: 0 8rpx 24rpx rgba(74,144,217,0.4);
  z-index: 99;
}

