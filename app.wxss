/* app.wxss 全局样式 —— 参考「薄荷健康」式布局 */
page {
  background-color: #F4F5F7;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Segoe UI, Arial, sans-serif;
  color: #1A1A1A;
  font-size: 28rpx;
}

.container {
  padding: 24rpx 24rpx 40rpx;
  box-sizing: border-box;
}

/* ============ 顶部头区 ============ */
.h-header {
  padding: 24rpx 8rpx 32rpx;
}

.h-top {
  display: flex;
  align-items: center;
}

.h-avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: #E9F8EF;
  text-align: center;
  line-height: 104rpx;
  font-size: 52rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.h-info {
  flex: 1;
  min-width: 0;
}

.h-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #111;
  line-height: 1.3;
}

.h-chips {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
}

.h-chip {
  font-size: 24rpx;
  color: #555;
  background: #fff;
  border-radius: 999rpx;
  padding: 8rpx 22rpx;
}

.h-link {
  font-size: 26rpx;
  color: #9AA0A6;
  flex-shrink: 0;
}

/* 子页标题 */
.page-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #111;
  margin: 16rpx 0 24rpx 8rpx;
}

/* ============ 卡片 ============ */
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
}

.card-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #111;
}

.section-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #111;
  margin: 36rpx 8rpx 20rpx;
}

/* ============ 胶囊筛选 ============ */
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
  overflow: visible;
}

.chip {
  flex-shrink: 0;
  padding: 16rpx 36rpx;
  border-radius: 999rpx;
  background: #EEF0F3;
  color: #555;
  font-size: 27rpx;
  line-height: 1.2;
}

.chip.active {
  background: #21C064;
  color: #fff;
  font-weight: 600;
}

/* ============ 通用布局 ============ */
.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-between {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.flex-1 {
  flex: 1;
  min-width: 0;
}

/* ============ 按钮 ============ */
.btn-primary {
  background: #21C064;
  color: #fff;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 600;
  padding: 22rpx 0;
  text-align: center;
}

.btn-primary[disabled] {
  background: #A9E6C4;
}

.btn-danger {
  background: #FDECEA;
  color: #E8503A;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 600;
  padding: 22rpx 0;
  text-align: center;
}

.btn-outline {
  background: #EEF0F3;
  color: #333;
  border: none;
  border-radius: 999rpx;
  font-size: 27rpx;
  padding: 14rpx 32rpx;
  text-align: center;
}

/* 大号浅色行动按钮（参考图"拍照识别"） */
.btn-soft {
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #E9F8EF;
  color: #21C064;
  font-size: 32rpx;
  font-weight: 600;
}

/* ============ 标签 ============ */
.tag {
  display: inline-block;
  padding: 6rpx 18rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
}

.tag-green {
  background: #E9F8EF;
  color: #14A457;
}

.tag-blue {
  background: #EAF2FD;
  color: #3F7FD9;
}

.tag-orange {
  background: #FDF1E4;
  color: #DB7A16;
}

.tag-red {
  background: #FDECEA;
  color: #E8503A;
}

.tag-gray {
  background: #F1F2F5;
  color: #8A8F99;
}

.text-muted {
  color: #9AA0A6;
  font-size: 24rpx;
}

.text-primary {
  color: #21C064;
}

.divider {
  height: 1rpx;
  background: #F0F1F4;
  margin: 24rpx 0;
}

.empty {
  text-align: center;
  padding: 140rpx 48rpx;
  color: #B6BAC2;
  font-size: 27rpx;
  line-height: 1.7;
}

/* ============ 表单 ============ */
.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  font-size: 26rpx;
  color: #9AA0A6;
  margin-bottom: 14rpx;
  display: block;
}

.form-input {
  width: 100%;
  height: 88rpx;
  background: #F4F5F7;
  border-radius: 20rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  font-size: 30rpx;
  color: #1A1A1A;
}

.form-textarea {
  width: 100%;
  min-height: 160rpx;
  background: #F4F5F7;
  border-radius: 20rpx;
  padding: 22rpx 28rpx;
  box-sizing: border-box;
  font-size: 30rpx;
}

.picker-box {
  background: #F4F5F7;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 30rpx;
  color: #1A1A1A;
}

.arrow {
  color: #C4C8D0;
  font-size: 40rpx;
  line-height: 1;
}

/* ============ 卡内列表 ============ */
.list {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
}

.list-row {
  display: flex;
  align-items: center;
  padding: 30rpx 32rpx;
}

.list-row + .list-row {
  border-top: 1rpx solid #F2F3F5;
}

.list-thumb {
  width: 88rpx;
  height: 88rpx;
  border-radius: 22rpx;
  background: #F4F5F7;
  text-align: center;
  line-height: 88rpx;
  font-size: 42rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.list-main {
  flex: 1;
  min-width: 0;
}

.list-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #111;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.list-sub {
  font-size: 24rpx;
  color: #9AA0A6;
  margin-top: 8rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.list-arrow {
  color: #C4C8D0;
  font-size: 40rpx;
  margin-left: 16rpx;
  line-height: 1;
}

.row-act {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #21C064;
  background: #E9F8EF;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  margin-left: 12rpx;
}

.row-del {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #E8503A;
  background: #FDECEA;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  margin-left: 12rpx;
}

/* ============ 四宫格菜单 ============ */
.grid-4 {
  display: flex;
  flex-wrap: wrap;
}

.grid-item {
  width: 25%;
  text-align: center;
  padding: 20rpx 0;
}

.grid-icon {
  width: 88rpx;
  height: 88rpx;
  line-height: 88rpx;
  margin: 0 auto 14rpx;
  border-radius: 28rpx;
  background: #F4F5F7;
  font-size: 44rpx;
}

.grid-name {
  font-size: 25rpx;
  color: #333;
}

/* ============ 概览卡 ============ */
.overview {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
}

.overview-stats {
  display: flex;
  margin-top: 8rpx;
}

.overview-stat {
  flex: 1;
  text-align: center;
}

.overview-num {
  font-size: 46rpx;
  font-weight: 700;
  color: #111;
  line-height: 1.2;
}

.overview-label {
  font-size: 22rpx;
  color: #9AA0A6;
  margin-top: 6rpx;
}

/* ============ 底部操作栏 / 悬浮按钮 ============ */
.footer-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  z-index: 100;
}

.fab {
  position: fixed;
  right: 36rpx;
  bottom: 60rpx;
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: #21C064;
  color: #fff;
  font-size: 60rpx;
  font-weight: 300;
  text-align: center;
  line-height: 104rpx;
  box-shadow: 0 12rpx 28rpx rgba(33, 192, 100, 0.35);
  z-index: 99;
}
