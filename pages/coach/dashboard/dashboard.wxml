<view class="container">
  <view class="header">
    <view class="welcome">你好，教练 👋</view>
    <view class="today">{{today}}</view>
  </view>

  <view class="stat-card">
    <view class="stat-item">
      <view class="stat-num">{{stats.totalRecords}}</view>
      <view class="stat-label">今日记录</view>
    </view>
  </view>

  <view class="menu-grid">
    <view wx:for="{{menuList}}" wx:key="name" class="menu-item" bindtap="goPage" data-url="{{item.url}}">
      <view class="menu-icon">{{item.icon}}</view>
      <view class="menu-name">{{item.name}}</view>
      <view wx:if="{{item.name==='学员审批' && pendingCount>0}}" class="badge">{{pendingCount}}</view>
    </view>
  </view>

  <view class="apply-btn" bindtap="applyGymAdmin">申请成为店长</view>

  <view class="logout" bindtap="logout">退出登录</view>
</view>
