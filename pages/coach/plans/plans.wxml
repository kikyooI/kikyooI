<view class="container">
  <view wx:if="{{plans.length===0}}" class="empty">暂无训练计划</view>

  <view wx:for="{{plans}}" wx:key="_id" class="card">
    <view class="flex-between">
      <view class="flex-1">
        <view class="plan-name">{{item.name}}</view>
        <view class="plan-meta">
          <text wx:if="{{item.assignedToName}}" class="tag tag-orange">分配给：{{item.assignedToName}}</text>
          <text wx:else class="tag tag-blue">公共模板</text>
          <text class="text-muted" style="margin-left:12rpx;">{{item.planDate}}</text>
          <text class="text-muted" style="margin-left:12rpx;">{{item.items.length}} 个动作</text>
        </view>
      </view>
      <view class="flex-row">
        <view class="btn-outline" catchtap="onEdit" data-id="{{item._id}}">编辑</view>
        <view class="btn-outline" style="color:#e74c3c;border-color:#e74c3c;margin-left:16rpx;" catchtap="onDelete" data-id="{{item._id}}">删除</view>
      </view>
    </view>
  </view>

  <view class="fab" bindtap="onAdd">+</view>
</view>
