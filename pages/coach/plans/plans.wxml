<view class="container">
  <view wx:if="{{plans.length===0}}" class="empty">暂无训练计划，点击右下角添加</view>

  <view wx:else class="list">
    <view wx:for="{{plans}}" wx:key="_id" class="list-row">
      <view class="list-thumb">📅</view>
      <view class="list-main">
        <view class="list-title">{{item.name}}</view>
        <view class="list-sub">
          <text>{{item.planDate || '未设日期'}}</text>
          <text> · {{item.assignedToName || '公共模板'}}</text>
          <text> · {{item.items.length}} 个动作</text>
        </view>
      </view>
      <text class="row-act" catchtap="onEdit" data-id="{{item._id}}">编辑</text>
      <text class="row-del" catchtap="onDelete" data-id="{{item._id}}">删除</text>
    </view>
  </view>

  <view class="fab" bindtap="onAdd">+</view>
</view>
