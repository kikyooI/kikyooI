<view class="container">
  <view class="chips">
    <picker mode="selector" range="{{students}}" range-key="name" value="{{studentIndex}}" bindchange="onStudentChange">
      <view class="chip active">{{students.length>0 ? students[studentIndex].name : '筛选学员'}} ▾</view>
    </picker>
  </view>

  <view wx:if="{{records.length===0}}" class="empty">暂无训练记录，点击右下角添加</view>

  <view wx:else class="list">
    <view wx:for="{{records}}" wx:key="_id" class="list-row" bindtap="goDetail" data-id="{{item._id}}">
      <view class="list-thumb">📋</view>
      <view class="list-main">
        <view class="list-title">{{item.studentName}}</view>
        <view class="list-sub">{{item.trainingDate}} · {{item.typeName}} · {{item.items.length}} 个动作</view>
      </view>
      <text class="list-arrow">›</text>
    </view>
  </view>

  <view wx:if="{{records.length>0}}" class="text-muted" style="text-align:center;padding:24rpx 0;">
    <text wx:if="{{loading}}">加载中...</text>
    <text wx:elif="{{!hasMore}}">没有更多了</text>
  </view>

  <view class="fab" bindtap="onAdd">+</view>
</view>
