.filter-bar {
  margin-bottom: 24rpx;
}

.filter-item {
  display: inline-block;
  background: #fff;
  padding: 12rpx 32rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #4A90D9;
}

.record-date {
  font-size: 32rpx;
  font-weight: 600;
}

.record-student {
  font-size: 26rpx;
  color: #666;
  margin-top: 6rpx;
}

.record-summary {
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
}

.arrow {
  color: #ccc;
  font-size: 40rpx;
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #4A90D9;
  color: #fff;
  font-size: 56rpx;
  text-align: center;
  line-height: 100rpx;
  box-shadow: 0 8rpx 24rpx rgba(74,144,217,0.4);
}
