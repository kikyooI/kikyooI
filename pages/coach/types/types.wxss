.type-name {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.seed-btn {
  background: #fff;
  border: 2rpx solid #4A90D9;
  color: #4A90D9;
  text-align: center;
  padding: 28rpx 0;
  border-radius: 16rpx;
  font-size: 30rpx;
  margin-bottom: 24rpx;
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #4A90D9;
  color: #fff;
  font-size: 56rpx;
  text-align: center;
  line-height: 100rpx;
  box-shadow: 0 8rpx 24rpx rgba(74,144,217,0.4);
}
