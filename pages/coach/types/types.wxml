<view class="container">
  <view wx:if="{{types.length === 0}}" class="empty">
    暂无训练类型，可导入初始数据或手动添加
  </view>

  <view wx:if="{{types.length === 0}}" class="seed-btn" bindtap="onSeed">📥 导入初始训练数据</view>

  <view wx:else class="list">
    <view wx:for="{{types}}" wx:key="_id" class="list-row">
      <view class="list-thumb">🏷️</view>
      <view class="list-main" catchtap="goExercises" data-id="{{item._id}}">
        <view class="list-title">{{item.name}}</view>
        <view class="list-sub">点击查看动作</view>
      </view>
      <text class="row-act" catchtap="onEdit" data-id="{{item._id}}">编辑</text>
      <text class="row-del" catchtap="onDelete" data-id="{{item._id}}">删除</text>
      <text class="list-arrow" catchtap="goExercises" data-id="{{item._id}}">›</text>
    </view>
  </view>

  <view class="fab" bindtap="onAdd">+</view>
</view>
