.picker-box {
  height: 80rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
}

.arrow {
  color: #ccc;
  font-size: 36rpx;
}

.ex-name {
  font-size: 30rpx;
  font-weight: 600;
}

.del-btn {
  color: #e74c3c;
  font-size: 32rpx;
  padding: 0 10rpx;
}

.set-header, .set-row {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
}

.set-header {
  background: #F4F5F8;
  border-radius: 14rpx;
  padding: 12rpx 16rpx;
  font-size: 24rpx;
  color: #999;
}

.set-col {
  flex: 1;
  text-align: center;
}

.set-col-act {
  width: 100rpx;
}

.set-input {
  flex: 1;
  height: 64rpx;
  background: #F4F5F8;
  border-radius: 14rpx;
  text-align: center;
  font-size: 26rpx;
  margin: 0 8rpx;
}

.set-del {
  width: 100rpx;
  text-align: center;
  font-size: 24rpx;
  color: #e74c3c;
}

.add-set {
  text-align: center;
  color: #21C064;
  font-size: 26rpx;
  padding: 16rpx 0;
  margin-top: 12rpx;
  border-top: 1rpx dashed #eee;
}

.add-exercise {
  background: #fff;
  border: 2rpx dashed #21C064;
  color: #21C064;
  text-align: center;
  padding: 28rpx 0;
  border-radius: 28rpx;
  font-size: 28rpx;
  margin-top: 16rpx;
}
