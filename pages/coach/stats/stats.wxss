.filter-bar {
  margin-bottom: 24rpx;
}

.filter-item {
  display: inline-block;
  background: #fff;
  padding: 12rpx 32rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #4A90D9;
}

.freq-row {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
}

.freq-date {
  width: 180rpx;
  font-size: 24rpx;
  color: #666;
}

.freq-bar-wrap {
  flex: 1;
  height: 24rpx;
  background: #f0f0f0;
  border-radius: 12rpx;
  margin: 0 16rpx;
  overflow: hidden;
}

.freq-bar {
  height: 100%;
  background: linear-gradient(90deg, #4A90D9, #357ABD);
  border-radius: 12rpx;
  min-width: 10rpx;
}

.freq-count {
  width: 100rpx;
  text-align: right;
  font-size: 24rpx;
  color: #999;
}

.dist-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
}

.trend-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
  color: #4A90D9;
}

.trend-row {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 0;
  font-size: 24rpx;
  color: #666;
}
