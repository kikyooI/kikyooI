.ex-name {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.type-selector {
  margin-bottom: 24rpx;
}

.picker-box {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 30rpx;
  color: #333;
}

.arrow {
  color: #999;
  font-size: 40rpx;
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #4A90D9;
  color: #fff;
  font-size: 56rpx;
  text-align: center;
  line-height: 100rpx;
  box-shadow: 0 8rpx 24rpx rgba(74,144,217,0.4);
}
