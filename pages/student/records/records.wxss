.menu-bar {
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.menu-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #666;
}

.menu-item.active {
  background: #4A90D9;
  color: #fff;
}

.record-date {
  font-size: 32rpx;
  font-weight: 600;
}

.record-type {
  font-size: 26rpx;
  color: #666;
  margin-top: 6rpx;
}

.arrow {
  color: #ccc;
  font-size: 40rpx;
}

.logout {
  text-align: center;
  color: #e74c3c;
  font-size: 28rpx;
  margin-top: 60rpx;
  padding: 20rpx;
}

.profile-link {
  margin-left: auto;
  font-size: 26rpx;
  color: #666;
  padding: 8rpx 0;
}


.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}

.hello {
  font-size: 40rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.hello-sub {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}

.profile-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #EAF3FC;
  text-align: center;
  line-height: 72rpx;
  font-size: 36rpx;
}

.card {
  border-left: 8rpx solid #4A90D9;
}


.fab {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #4A90D9;
  color: #fff;
  font-size: 56rpx;
  text-align: center;
  line-height: 100rpx;
  box-shadow: 0 8rpx 24rpx rgba(74,144,217,0.4);
  z-index: 99;
}


/* 给自定义tabBar留出底部空间 */
page {
  padding-bottom: 160rpx;
}

