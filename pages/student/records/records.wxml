<view class="container">
  <view class="page-header">
    <view>
      <view class="hello">你好，{{name}}</view>
      <view class="hello-sub">坚持训练，遇见更好的自己 💪</view>
    </view>
    <view class="profile-avatar" bindtap="goProfile">👤</view>
  </view>

  <view wx:if="{{records.length===0}}" class="empty">暂无训练记录</view>

  <view wx:for="{{records}}" wx:key="_id" class="card" bindtap="goDetail" data-id="{{item._id}}">
    <view class="flex-between">
      <view>
        <view class="record-date">{{item.trainingDate}}</view>
        <view class="record-type">{{item.typeName}} · {{item.items.length}}个动作</view>
      </view>
      <text class="arrow">›</text>
    </view>
    <view wx:if="{{item.notes}}" class="text-muted" style="margin-top:8rpx;">{{item.notes}}</view>
  </view>

  <view wx:if="{{records.length>0}}" class="text-muted" style="text-align:center;padding:24rpx 0;">
    <text wx:if="{{loading}}">加载中...</text>
    <text wx:elif="{{!hasMore}}">没有更多了</text>
  </view>

  <view class="fab" style="bottom:200rpx;" bindtap="onAdd">+</view>

  <view class="logout" bindtap="logout">退出登录</view>
</view>
