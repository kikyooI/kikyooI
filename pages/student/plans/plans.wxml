<view class="container">
  <view wx:if="{{plans.length===0}}" class="empty">暂无训练计划，点击右下角添加</view>

  <view wx:else class="list">
    <view wx:for="{{plans}}" wx:key="_id" class="list-row" catchtap="onEdit" data-id="{{item._id}}">
      <view class="list-thumb">📅</view>
      <view class="list-main">
        <view class="list-title">{{item.name}}</view>
        <view class="list-sub">
          <text>{{item.planDate || '未设日期'}}</text>
          <text> · {{item.items.length}} 个动作</text>
        </view>
      </view>
      <text wx:if="{{item.createdBy===openid}}" class="tag tag-green">我创建</text>
      <text wx:elif="{{item.assignedTo===openid}}" class="tag tag-orange">分配给我</text>
      <text class="list-arrow">›</text>
    </view>
  </view>

  <view class="fab" style="bottom:200rpx;" bindtap="onAdd">+</view>
</view>
