.picker-box {
  height: 80rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
}

.arrow {
  color: #ccc;
  font-size: 36rpx;
}

.ex-name {
  font-size: 30rpx;
  font-weight: 600;
}

.del-btn {
  color: #e74c3c;
  font-size: 32rpx;
  padding: 0 10rpx;
}

.set-config {
  flex: 1;
  margin-right: 20rpx;
}

.set-label {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.set-num-input {
  height: 72rpx;
  background: #F4F5F8;
  border-radius: 20rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
}

.add-exercise {
  background: #fff;
  border: 2rpx dashed #21C064;
  color: #21C064;
  text-align: center;
  padding: 28rpx 0;
  border-radius: 28rpx;
  font-size: 28rpx;
  margin-top: 16rpx;
}
