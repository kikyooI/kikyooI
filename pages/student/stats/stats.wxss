.stat-overview {
  background: linear-gradient(135deg, #21C064 0%, #357ABD 100%);
  border-radius: 28rpx;
  padding: 48rpx;
  text-align: center;
  color: #fff;
  margin-bottom: 32rpx;
}

.stat-num {
  font-size: 72rpx;
  font-weight: 700;
}

.stat-label {
  font-size: 26rpx;
  opacity: 0.9;
  margin-top: 8rpx;
}

.freq-row {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
}

.freq-date {
  width: 180rpx;
  font-size: 24rpx;
  color: #666;
}

.freq-bar-wrap {
  flex: 1;
  height: 24rpx;
  background: #f0f0f0;
  border-radius: 20rpx;
  margin: 0 16rpx;
  overflow: hidden;
}

.freq-bar {
  height: 100%;
  background: linear-gradient(90deg, #21C064, #357ABD);
  border-radius: 20rpx;
  min-width: 10rpx;
}

.freq-count {
  width: 100rpx;
  text-align: right;
  font-size: 24rpx;
  color: #999;
}

.dist-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
}

.trend-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
  color: #21C064;
}

.trend-row {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 0;
  font-size: 24rpx;
  color: #666;
}

/* 给自定义tabBar留出底部空间 */
page {
  padding-bottom: 160rpx;
}

