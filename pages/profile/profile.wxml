<view class="container">
  <view class="card">
    <view class="form-item">
      <text class="form-label">姓名 *</text>
      <input class="form-input" placeholder="请输入姓名" value="{{name}}" data-field="name" bindinput="onInput" />
    </view>

    <view class="form-item">
      <text class="form-label">手机号</text>
      <input class="form-input" type="number" maxlength="11" placeholder="请输入手机号" value="{{phone}}" data-field="phone" bindinput="onInput" />
    </view>

    <view class="form-item">
      <text class="form-label">角色</text>
      <view class="picker-box">{{roleName}}</view>
    </view>

    <view class="form-item">
      <text class="form-label">所属健身房</text>
      <view class="picker-box">{{gymName || '加载中...'}}</view>
    </view>
  </view>

  <view style="height:120rpx;"></view>

  <view class="footer-bar">
    <button class="btn-primary" bindtap="submit" loading="{{loading}}" disabled="{{loading}}">保存</button>
  </view>
</view>
