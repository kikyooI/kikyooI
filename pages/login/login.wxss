.login-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 60rpx;
  background: #F2F2F5;
}

.logo {
  text-align: center;
  margin-bottom: 100rpx;
}

.logo-icon {
  width: 160rpx;
  height: 160rpx;
  margin: 0 auto 36rpx;
  border-radius: 48rpx;
  background: #fff;
  font-size: 88rpx;
  line-height: 160rpx;
  text-align: center;
  box-shadow: 0 12rpx 32rpx rgba(33,192,100, 0.14);
}

.logo-title {
  color: #111;
  font-size: 52rpx;
  font-weight: 700;
  margin-bottom: 14rpx;
}

.logo-subtitle {
  color: #8A8F99;
  font-size: 28rpx;
}

.login-btn {
  width: 100%;
}

.login-btn .btn-primary {
  height: 96rpx;
  line-height: 96rpx;
  box-shadow: 0 12rpx 28rpx rgba(33,192,100, 0.28);
}
