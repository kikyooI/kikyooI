<view class="container" wx:if="{{record}}">
  <view class="card">
    <view class="detail-header">
      <view class="detail-date">{{record.trainingDate}}</view>
      <view class="detail-meta">
        <text class="tag tag-blue">{{record.typeName}}</text>
      </view>
    </view>
    <view class="detail-info">
      <view class="info-row">
        <text class="info-label">学员</text>
        <text class="info-value">{{record.studentName}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">教练</text>
        <text class="info-value">{{record.coachName}}</text>
      </view>
    </view>
  </view>

  <view class="section-title">训练内容</view>

  <view wx:for="{{record.items}}" wx:key="exerciseId" class="card">
    <view class="ex-name">{{item.name}}</view>
    <view class="set-header">
      <text class="set-col">组</text>
      <text class="set-col">个数</text>
      <text class="set-col">重量(kg)</text>
    </view>
    <view wx:for="{{item.sets}}" wx:for-item="set" wx:for-index="setIdx" wx:key="setIdx" class="set-row">
      <text class="set-col">{{setIdx+1}}</text>
      <text class="set-col">{{set.reps}}</text>
      <text class="set-col">{{set.weight || '-'}}</text>
    </view>
    <view wx:if="{{item.notes}}" class="text-muted" style="margin-top:12rpx;">备注：{{item.notes}}</view>
  </view>

  <view wx:if="{{record.notes}}" class="card">
    <view class="section-title" style="margin:0 0 12rpx;">训练备注</view>
    <view class="text-muted">{{record.notes}}</view>
  </view>

  <view wx:if="{{canEdit}}" style="height:120rpx;"></view>

  <view wx:if="{{canEdit}}" class="footer-bar footer-actions">
    <view class="btn-danger footer-del" catchtap="onDelete">删除</view>
    <button class="btn-primary footer-edit" bindtap="goEdit">编辑记录</button>
  </view>
</view>

<view wx:else class="empty">加载中...</view>
