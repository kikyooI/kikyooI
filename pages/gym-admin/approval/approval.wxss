.user-name {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.user-meta {
  display: flex;
  align-items: center;
}

.tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.tag-blue {
  background: #E9F8EF;
  color: #21C064;
}

.tag-green {
  background: #e8f8f0;
  color: #27ae60;
}

.tag-orange {
  background: #fff3e0;
  color: #e67e22;
}

.pass-btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background: #21C064;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 999rpx;
  margin-right: 20rpx;
}

.reject-btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background: #FDECEA;
  color: #E8503A;
  font-size: 28rpx;
  border-radius: 999rpx;
}
