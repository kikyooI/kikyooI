.user-name {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.user-meta {
  display: flex;
  align-items: center;
}

.tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.tag-blue {
  background: #e8f4fd;
  color: #4A90D9;
}

.tag-green {
  background: #e8f8f0;
  color: #27ae60;
}

.tag-orange {
  background: #fff3e0;
  color: #e67e22;
}
