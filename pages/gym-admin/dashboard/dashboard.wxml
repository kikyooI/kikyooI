<view class="container">
  <view style="height:{{statusBarHeight}}px;"></view>
  <view class="h-header">
    <view class="h-top">
      <view class="h-avatar">🛡️</view>
      <view class="h-info">
        <view class="h-name">{{name || '店长'}}</view>
        <view class="h-chips">
          <text class="h-chip">待审批 {{pendingCount}}</text>
          <text wx:if="{{isSuperAdmin}}" class="h-chip">超管模式</text>
        </view>
      </view>
      <view class="h-link" bindtap="goPage" data-url="/pages/profile/profile">我的资料 ›</view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">门店概览</view>
    <view class="overview-stats" style="margin-top:24rpx;">
      <view class="overview-stat">
        <view class="overview-num">{{pendingCount}}</view>
        <view class="overview-label">待审批人数</view>
      </view>
      <view class="overview-stat">
        <view class="overview-num">{{coachCount || 0}}</view>
        <view class="overview-label">教练</view>
      </view>
      <view class="overview-stat">
        <view class="overview-num">{{studentCount || 0}}</view>
        <view class="overview-label">学员</view>
      </view>
    </view>
  </view>

  <view class="card" style="padding:16rpx 8rpx;">
    <view class="grid-4">
      <view wx:for="{{menuList}}" wx:key="name" class="grid-item" bindtap="goPage" data-url="{{item.url}}">
        <view class="grid-icon">{{item.icon}}</view>
        <view class="grid-name">{{item.name}}</view>
      </view>
    </view>
  </view>

  <view class="list">
    <view wx:if="{{isSuperAdmin}}" class="list-row" bindtap="exitGym">
      <view class="list-thumb">↩️</view>
      <view class="list-main">
        <view class="list-title">返回超管工作台</view>
        <view class="list-sub">退出当前门店管理模式</view>
      </view>
      <text class="list-arrow">›</text>
    </view>
    <view class="list-row" bindtap="logout">
      <view class="list-thumb">🚪</view>
      <view class="list-main">
        <view class="list-title">退出登录</view>
      </view>
      <text class="list-arrow">›</text>
    </view>
  </view>
</view>
