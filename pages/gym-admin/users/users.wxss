.user-name {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.user-meta {
  display: flex;
  align-items: center;
}

.tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.tag-blue {
  background: #E9F8EF;
  color: #21C064;
}

.tag-green {
  background: #e8f8f0;
  color: #27ae60;
}

.tag-orange {
  background: #fff3e0;
  color: #e67e22;
}

.tag-red {
  background: #fdecea;
  color: #e74c3c;
}

.filter-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 0;
  margin-bottom: 24rpx;
  overflow: visible;
}

.tab {
  flex-shrink: 0;
  padding: 16rpx 36rpx;
  font-size: 27rpx;
  color: #444;
  background: #ECECF1;
  border-radius: 999rpx;
}

.tab.active {
  background: #21C064;
  color: #fff;
  font-weight: 600;
}

.action-row {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
  flex-wrap: wrap;
}

.action-btn {
  padding: 14rpx 30rpx;
  border-radius: 999rpx;
  font-size: 25rpx;
  border: none;
  background: #F0F2F6;
  color: #333;
}

.btn-primary {
  background: #E9F8EF;
  color: #21C064;
  font-weight: 600;
}

.btn-danger {
  background: #FDECEA;
  color: #E8503A;
}
