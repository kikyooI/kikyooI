.role-select {
  display: flex;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.role-card {
  flex: 1;
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx 24rpx;
  text-align: center;
  border: 3rpx solid transparent;
  transition: all 0.2s;
}

.role-card.active {
  border-color: #4A90D9;
  background: #f0f7ff;
}

.role-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.role-name {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.role-desc {
  font-size: 22rpx;
  color: #999;
}

.picker-box {
  height: 80rpx;
  background: #fff;
  border-radius: 12rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
}

.arrow {
  color: #ccc;
  font-size: 36rpx;
}
