.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  background: #ffffff;
  border-top: 1rpx solid #EEEEEE;
  padding-top: 12rpx;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 999;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 6rpx 0 10rpx;
}

.tab-icon {
  font-size: 46rpx;
  line-height: 1.2;
  filter: grayscale(1);
  opacity: 0.45;
}

.tab-icon.active {
  filter: none;
  opacity: 1;
}

.tab-text {
  font-size: 26rpx;
  color: #999999;
  margin-top: 4rpx;
}

.tab-text.active {
  color: #4A90D9;
  font-weight: 600;
}
