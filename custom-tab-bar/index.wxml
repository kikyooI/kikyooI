<view class="tab-bar">
  <view wx:for="{{list}}" wx:key="text" class="tab-item" data-path="{{item.pagePath}}" data-index="{{index}}" bindtap="switchTab">
    <view class="tab-icon {{selected===index?'active':''}}">{{item.icon}}</view>
    <view class="tab-text {{selected===index?'active':''}}">{{item.text}}</view>
  </view>
</view>
